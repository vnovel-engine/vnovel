# Libretro coding standards for the vnovel core's own sources.
# See libretro-docs/docs/development/coding-standards.md: three-space indent,
# Allman braces, 80 columns, C89-compatible declarations.
#
# Scope: src/*.{c,cpp,h} of this repository only. The engine submodules under
# deps/ and smpeg/ keep upstream formatting and are excluded (see the lint job
# in .gitlab-ci.yml).
---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 3
TabWidth: 3
UseTab: Never
ContinuationIndentWidth: 6
ColumnLimit: 80

# Allman: the brace for a control statement goes on its own line, at the same
# level as the statement.
BreakBeforeBraces: Allman
AllowShortIfStatementsOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty

AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: false
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false

PointerAlignment: Right
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInParentheses: false
IndentCaseLabels: false
IndentPPDirectives: None
MaxEmptyLinesToKeep: 1

ReflowComments: false
SortIncludes: Never
