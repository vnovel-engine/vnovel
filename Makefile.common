# =============================================================================
# vnovel Libretro Core — Source lists and include paths
# =============================================================================

# --- Directory layout ---
DEPS_DIR        := $(CORE_DIR)/deps
LIBRETRO_COMM   := $(DEPS_DIR)/libretro-common
SDL_LIBRETRO    := $(SRC_DIR)/sdl-libretro
ONSCRIPTER_EN   := $(DEPS_DIR)/onscripter-en
PONSCRIPTER     := $(DEPS_DIR)/ponscripter/src
SMPEG_DIR       := $(CORE_DIR)/smpeg
SDL_DIR         := $(DEPS_DIR)/sdl

# --- Include paths (shared) ---
INCFLAGS := \
  -I$(LIBRETRO_COMM)/include \
  -I$(ONSCRIPTER_EN) \
  -I$(PONSCRIPTER) \
  -I$(DEPS_DIR)/bzip2 \
  -I$(DEPS_DIR)/libogg/include \
  -I$(DEPS_DIR)/libvorbis/include \
  -I$(DEPS_DIR)/libmad \
  -I$(SDL_LIBRETRO) \
  -I$(SDL_DIR)/include \
  -I$(DEPS_DIR) \
  -I$(DEPS_DIR)/sdl-mixer \
  -I$(CORE_DIR) \
  -I$(SRC_DIR) \
  -I$(CORE_DIR)/resources/fonts \
  -I$(SMPEG_DIR)

CFLAGS   += $(INCFLAGS)
CXXFLAGS += $(INCFLAGS)

# Append points for a caller that needs to add flags.
#
# A caller must NOT pass CFLAGS/CXXFLAGS/LDFLAGS on the make command line for
# this: a command-line assignment replaces the variable outright and silences
# every `+=` in these files, so the include paths and defines above — including
# the vendored-SDL rename and the freetype include — silently disappear. (A
# buildroot recipe did exactly that, and the failure surfaced as a missing
# ft2build.h rather than as the flag it actually was.) These variables extend
# rather than replace, so the makefiles keep working the same way.
CFLAGS   += $(EXTRA_CFLAGS)
CXXFLAGS += $(EXTRA_CXXFLAGS)
LDFLAGS  += $(EXTRA_LDFLAGS)

# Force our SDL config (dummy backends only) on all platforms.
# sdl-vendored.h comes first and renames our SDL/SDL_mixer/SMPEG/TTF/IMG symbols
# to a Private prefix, so they cannot collide with the SDL2/SDL3 the frontend
# loads globally. It must be included before SDL's own headers, hence first in
# the -include chain; see tools/gen_sdl_vendored.py for the full rationale.
#
# Bootstrapping has an ordering problem: the rename list is generated from the
# symbols the vendored objects define, but those objects are compiled with the
# list applied. Build once with VENDORED_BOOTSTRAP=1 (renames off) and run the
# generator — that is what `make regen-vendored` does.
ifeq ($(VENDORED_BOOTSTRAP),1)
VENDORED_INCLUDE :=
else
# RENAME_SDL_SYMBOLS gates the sdl-vendored.h rename. One definition site:
# it must reach the vendored SDL sources AND every consumer, or the definitions
# and the call sites disagree (undefined PrivateSDL_* at link time).
VENDORED_INCLUDE := -D__RETRO__ -DRENAME_SDL_SYMBOLS -include $(CORE_DIR)/sdl-vendored.h
endif
CFLAGS   += $(VENDORED_INCLUDE) -include $(SDL_LIBRETRO)/SDL_config_libretro.h
CXXFLAGS += $(VENDORED_INCLUDE) -include $(SDL_LIBRETRO)/SDL_config_libretro.h

# --- libmad config ---
CFLAGS += -DFPM_DEFAULT -DSIZEOF_INT=4

# --- SDL_mixer config ---
CFLAGS += -DOGG_MUSIC -DMP3_MAD_MUSIC

# --- Thread library ---
LDFLAGS += -lpthread -lfreetype

# =============================================================================
# Source files
# =============================================================================

# --- bzip2 ---
RUNTIME_C += $(addprefix $(DEPS_DIR)/bzip2/, \
  blocksort.c huffman.c crctable.c randtable.c \
  compress.c decompress.c bzlib.c \
)

# --- libogg ---
RUNTIME_C += $(addprefix $(DEPS_DIR)/libogg/src/, \
  bitwise.c framing.c \
)

# --- libvorbis ---
RUNTIME_C += $(addprefix $(DEPS_DIR)/libvorbis/lib/, \
  mdct.c smallft.c block.c envelope.c window.c lsp.c \
  lpc.c analysis.c synthesis.c psy.c info.c \
  floor1.c floor0.c res0.c mapping0.c registry.c \
  codebook.c sharedbook.c lookup.c bitrate.c vorbisfile.c \
)

# --- libmad (MP3 decoder) ---
RUNTIME_C += $(addprefix $(DEPS_DIR)/libmad/, \
  version.c fixed.c bit.c timer.c stream.c frame.c \
  synth.c decoder.c layer12.c layer3.c huffman.c \
)

# --- SDL 1.2 (core, with dummy backends) ---
RUNTIME_C += $(addprefix $(SDL_DIR)/src/, \
  SDL.c SDL_error.c SDL_fatal.c \
  audio/SDL_audio.c audio/SDL_audiocvt.c audio/SDL_audiodev.c \
  audio/SDL_mixer.c audio/SDL_mixer_m68k.c audio/SDL_wave.c \
  cdrom/SDL_cdrom.c \
  cpuinfo/SDL_cpuinfo.c \
  events/SDL_active.c events/SDL_events.c events/SDL_expose.c \
  events/SDL_keyboard.c events/SDL_mouse.c events/SDL_quit.c \
  events/SDL_resize.c \
  file/SDL_rwops.c \
  joystick/SDL_joystick.c \
  stdlib/SDL_getenv.c stdlib/SDL_iconv.c \
  stdlib/SDL_malloc.c stdlib/SDL_qsort.c \
  stdlib/SDL_stdlib.c stdlib/SDL_string.c \
  thread/SDL_thread.c \
  thread/pthread/SDL_syscond.c thread/pthread/SDL_sysmutex.c \
  thread/pthread/SDL_syssem.c thread/pthread/SDL_systhread.c \
  timer/SDL_timer.c timer/$(SDL_SYSTIMER) \
  video/SDL_blit_0.c video/SDL_blit_1.c video/SDL_blit_A.c \
  video/SDL_blit.c video/SDL_blit_N.c video/SDL_bmp.c video/SDL_cursor.c \
  video/SDL_gamma.c video/SDL_pixels.c video/SDL_RLEaccel.c \
  video/SDL_stretch.c video/SDL_surface.c video/SDL_video.c \
  video/SDL_yuv.c video/SDL_yuv_mmx.c video/SDL_yuv_sw.c \
  cdrom/dummy/SDL_syscdrom.c \
  joystick/dummy/SDL_sysjoystick.c \
  loadso/dummy/SDL_sysloadso.c \
)

# --- SDL → libretro bridge ---
RUNTIME_C += $(addprefix $(SDL_LIBRETRO)/, \
  audio.c events.c video.c SDL_ttf.c \
)
RUNTIME_CXX += $(SDL_LIBRETRO)/SDL_image.cpp

# --- SDL_mixer ---
RUNTIME_C += $(addprefix $(DEPS_DIR)/sdl-mixer/, \
  mixer.c music.c effects_internal.c effect_position.c \
  load_voc.c load_aiff.c load_ogg.c music_ogg.c \
  dynamic_ogg.c music_mad.c \
)

# --- libretro-common ---
RUNTIME_C += $(addprefix $(LIBRETRO_COMM)/, \
  compat/compat_strl.c \
  encodings/encoding_utf.c \
  encodings/encoding_crc32.c \
  streams/file_stream.c \
  vfs/vfs_implementation.c \
  string/stdstring.c \
  time/rtime.c \
  file/file_path.c \
)

# --- SMPEG (MPEG-1 audio/video decoder) ---
RUNTIME_C   += $(SMPEG_DIR)/MPEGfilter.c
RUNTIME_CXX += $(addprefix $(SMPEG_DIR)/, \
  MPEG.cpp MPEGlist.cpp MPEGring.cpp MPEGstream.cpp MPEGsystem.cpp smpeg.cpp \
)
RUNTIME_CXX += $(addprefix $(SMPEG_DIR)/audio/, \
  MPEGaudio.cpp bitwindow.cpp filter.cpp filter_2.cpp hufftable.cpp \
  mpeglayer1.cpp mpeglayer2.cpp mpeglayer3.cpp mpegtable.cpp mpegtoraw.cpp \
)
RUNTIME_CXX += $(addprefix $(SMPEG_DIR)/video/, \
  MPEGvideo.cpp decoders.cpp floatdct.cpp gdith.cpp jrevdct.cpp \
  motionvec.cpp parseblock.cpp readfile.cpp util.cpp vhar128.cpp video.cpp \
)

# =============================================================================
# Engine: ONScripter-EN
# Compiled as a static library with -fvisibility=hidden to avoid symbol
# conflicts with PONScripter (they share class names like ScriptHandler).
# =============================================================================
ONS_CXX := $(addprefix $(ONSCRIPTER_EN)/, \
  ONScripterLabel.cpp \
  ONScripterLabel_animation.cpp \
  ONScripterLabel_command.cpp \
  ONScripterLabel_effect.cpp \
  ONScripterLabel_effect_breakup.cpp \
  ONScripterLabel_effect_cascade.cpp \
  ONScripterLabel_effect_trig.cpp \
  ONScripterLabel_event.cpp \
  ONScripterLabel_file.cpp \
  ONScripterLabel_file2.cpp \
  ONScripterLabel_image.cpp \
  ONScripterLabel_rmenu.cpp \
  ONScripterLabel_sound.cpp \
  ONScripterLabel_text.cpp \
  ONScripterLookAhead.cpp \
  resize_image.cpp \
  sjis2utf16.cpp \
  DirectReader.cpp \
  SarReader.cpp \
  NsaReader.cpp \
  ScriptHandler.cpp \
  ScriptParser.cpp \
  ScriptParser_command.cpp \
  FontInfo.cpp \
  AnimationInfo.cpp \
  DirtyRect.cpp \
  DirPaths.cpp \
  Layer.cpp \
  MadWrapper.cpp \
  graphics_routines.cpp \
)

ONS_OBJS := $(ONS_CXX:.cpp=.ons.o)
$(ONS_OBJS): CXXFLAGS += -fvisibility=hidden

# =============================================================================
# Engine: PONScripter
# Same approach — hidden visibility, separate object files.
# =============================================================================
PONS_CXX := $(addprefix $(PONSCRIPTER)/, \
  PonscripterWrap.cpp \
  PonscripterLabel.cpp \
  PonscripterLabel_animation.cpp \
  PonscripterLabel_command.cpp \
  PonscripterLabel_effect.cpp \
  PonscripterLabel_event.cpp \
  PonscripterLabel_ext.cpp \
  PonscripterLabel_file.cpp \
  PonscripterLabel_file2.cpp \
  PonscripterLabel_image.cpp \
  PonscripterLabel_rmenu.cpp \
  PonscripterLabel_sound.cpp \
  PonscripterLabel_text.cpp \
  ScriptHandler.cpp \
  ScriptParser.cpp \
  ScriptParser_command.cpp \
  AnimationInfo.cpp \
  DirtyRect.cpp \
  DirPaths.cpp \
  DirectReader.cpp \
  SarReader.cpp \
  NsaReader.cpp \
  MadWrapper.cpp \
  resize_image.cpp \
  font.cpp \
  Fontinfo.cpp \
  encoding.cpp \
  cp932_encoding.cpp \
  expression.cpp \
  prng.cpp \
  pstring.cpp \
  bstrwrap.cpp \
  PONScripterLookAhead.cpp \
)

PONS_OBJS := $(PONS_CXX:.cpp=.pons.o)
PONS_C := $(PONSCRIPTER)/bstrlib.c
PONS_OBJS += $(PONS_C:.c=.pons.o)

# =============================================================================
# Core files
# =============================================================================
# The core keeps only the libretro entry points and the KiriKiri ABI (which is
# already dlopen-based). Everything the engines share — SDL, the sdl-libretro
# glue, the mixer, SMPEG, the decoders, the bridge — is in the runtime module
# below, because there must be exactly one live SDL and it must be the one the
# engine's event loop is blocked in.
#
# The RC file: linking
#
#   core -> runtime, engine_ons, engine_pons
#   engine_ons -> runtime
#   engine_pons -> runtime
#
# so core and engines all resolve SDL to the same runtime object.
CORE_CXX := \
  $(SRC_DIR)/libretro.cpp \
  $(SRC_DIR)/menu.cpp \
  $(SRC_DIR)/wrap.cpp

# KiriKiri is opt-in: its engine is still being brought up, so it is not part
# of a release build. Off, engine_kirikiri_cabi.cpp is not compiled, the
# krkrsdl2 archive is not linked, and libretro.cpp compiles the KiriKiri path
# out entirely (see VNOVEL_KIRIKIRI). Build it with `make KRKR_ENABLE=1`.
ifeq ($(KRKR_ENABLE),1)
   CORE_CXX += $(SRC_DIR)/engine_kirikiri_cabi.cpp
endif

# The bridge holds state core, runtime and engines all use. It lives in the
# runtime so every module resolves the same copy (see the one-bridge-file
# contract in engine_bridge.c).
RUNTIME_C += $(SRC_DIR)/engine_bridge.c

# embed_stub provides getResource(), which the engines call; it belongs with the
# engine-side runtime rather than the core.
RUNTIME_CXX += $(SRC_DIR)/embed_stub.cpp

# The development socket (the text stream out, navigation intents in). In the
# runtime, not the core: it is transport, and both are in the same .so anyway.
RUNTIME_C += $(SRC_DIR)/devsock.c

# engine_ons_cabi.o / engine_pons_cabi.o are built by the generic
# $(BUILD_DIR)/%.o rule, so their engine-specific flags have to be attached to
# the object target, not to a hand-written rule. A hand-written
# `$(BUILD_DIR)/engine_ons_cabi.o:` rule does not match anything: the object is
# produced at $(BUILD_DIR)/src/engine_ons_cabi.o, so such a rule is dead code
# that silently drops its flags. (It was, until this comment existed.)
$(BUILD_DIR)/$(SRC_DIR)/engine_ons_cabi.o: CXXFLAGS += $(ONS_RENAME)
$(BUILD_DIR)/$(SRC_DIR)/engine_pons_cabi.o: CXXFLAGS += $(PONS_RENAME)

# The C ABI wrapper for each engine compiles into that engine's module: it
# constructs the engine class, which lives there, and only its vtable is
# exported.
ONS_EXTRA_CXX := $(SRC_DIR)/engine_ons_cabi.cpp
PONS_EXTRA_CXX := $(SRC_DIR)/engine_pons_cabi.cpp

# --- NP2kai menu (vendored, MIT (c) 2017 AZO) ---
# The native menu's foundation, vendored bottom-up: the VRAM abstraction and
# font manager first, the menu itself later. See deps/np2kai-menu/README.md for
# the adaptation layer, and why the vendored sources are unmodified.
#
# The defines are upstream's own for its SDL target: all three colour depths
# together, the TTF path selected, and the SDL1 TTF API - which is what this
# tree's src/sdl-libretro/SDL_ttf.h implements, even though the engine side is
# SDL2 (the same arrangement the rest of the core uses).
NP2KAI_MENU := $(DEPS_DIR)/np2kai-menu

RUNTIME_C += $(addprefix $(NP2KAI_MENU)/, \
  common/rect.c common/resize.c common/lstarray.c common/strres.c \
  embed/vramhdl.c embed/vrammix.c embed/fontmng.c \
  embed/menubase/menubase.c embed/menubase/menudlg.c \
  embed/menubase/menuicon.c embed/menubase/menumbox.c \
  embed/menubase/menures.c embed/menubase/menusys.c \
  embed/menubase/menuvram.c \
  host.c \
)

# The vendor directory mirrors upstream's own layout (common/, embed/), so the
# sources' includes - <embed/menubase/menubase.h>, <common/rect.h>, and the bare
# <fontmng.h> that upstream's SDL build resolves from its sdl/ directory - all
# resolve without editing them. include/ holds only this port's adaptation layer.
NP2KAI_INCLUDES := -I$(NP2KAI_MENU)/include -I$(NP2KAI_MENU) -I$(NP2KAI_MENU)/embed
NP2KAI_DEFINES := -DSUPPORT_16BPP -DSUPPORT_24BPP -DSUPPORT_32BPP \
                  -DSUPPORT_SDL_TTF -DUSE_SDL=1
# Both languages: menu.cpp is C++ and includes the same headers as the C
# sources it drives.
CFLAGS   += $(NP2KAI_INCLUDES) $(NP2KAI_DEFINES)
CXXFLAGS += $(NP2KAI_INCLUDES) $(NP2KAI_DEFINES)

