# =============================================================================
# ONScripter-EN Libretro Core — Source lists and include paths
# =============================================================================

# --- Directory layout ---
DEPS_DIR        := $(CORE_DIR)/deps
LIBRETRO_COMM   := $(DEPS_DIR)/libretro-common
SDL_LIBRETRO    := $(CORE_DIR)/sdl-libretro
ONSCRIPTER_EN   := $(DEPS_DIR)/onscripter-en
PONSCRIPTER     := $(DEPS_DIR)/ponscripter/src
SMPEG_DIR       := $(CORE_DIR)/smpeg
SDL_DIR         := $(DEPS_DIR)/sdl

# --- Include paths (shared) ---
INCFLAGS := \
  -I$(LIBRETRO_COMM)/include \
  -I$(ONSCRIPTER_EN) \
  -I$(PONSCRIPTER) \
  -I$(DEPS_DIR)/bzip2 \
  -I$(DEPS_DIR)/libogg/include \
  -I$(DEPS_DIR)/libvorbis/include \
  -I$(DEPS_DIR)/libmad \
  -I$(SDL_LIBRETRO) \
  -I$(SDL_DIR)/include \
  -I$(DEPS_DIR) \
  -I$(DEPS_DIR)/sdl-mixer \
  -I$(CORE_DIR) \
  -I$(SMPEG_DIR)

CFLAGS   += $(INCFLAGS)
CXXFLAGS += $(INCFLAGS)

# Force our SDL config (dummy backends only) on all platforms
CFLAGS   += -include $(SDL_LIBRETRO)/SDL_config_libretro.h
CXXFLAGS += -include $(SDL_LIBRETRO)/SDL_config_libretro.h

# --- libmad config ---
CFLAGS += -DFPM_DEFAULT -DSIZEOF_INT=4

# --- SDL_mixer config ---
CFLAGS += -DOGG_MUSIC -DMP3_MAD_MUSIC

# --- Thread library ---
LDFLAGS += -lpthread -lfreetype

# =============================================================================
# Source files
# =============================================================================

# --- bzip2 ---
SOURCES_C += $(addprefix $(DEPS_DIR)/bzip2/, \
  blocksort.c huffman.c crctable.c randtable.c \
  compress.c decompress.c bzlib.c \
)

# --- libogg ---
SOURCES_C += $(addprefix $(DEPS_DIR)/libogg/src/, \
  bitwise.c framing.c \
)

# --- libvorbis ---
SOURCES_C += $(addprefix $(DEPS_DIR)/libvorbis/lib/, \
  mdct.c smallft.c block.c envelope.c window.c lsp.c \
  lpc.c analysis.c synthesis.c psy.c info.c \
  floor1.c floor0.c res0.c mapping0.c registry.c \
  codebook.c sharedbook.c lookup.c bitrate.c vorbisfile.c \
)

# --- libmad (MP3 decoder) ---
SOURCES_C += $(addprefix $(DEPS_DIR)/libmad/, \
  version.c fixed.c bit.c timer.c stream.c frame.c \
  synth.c decoder.c layer12.c layer3.c huffman.c \
)

# --- SDL 1.2 (core, with dummy backends) ---
SOURCES_C += $(addprefix $(SDL_DIR)/src/, \
  SDL.c SDL_error.c SDL_fatal.c \
  audio/SDL_audio.c audio/SDL_audiocvt.c audio/SDL_audiodev.c \
  audio/SDL_mixer.c audio/SDL_mixer_m68k.c audio/SDL_wave.c \
  cdrom/SDL_cdrom.c \
  cpuinfo/SDL_cpuinfo.c \
  events/SDL_active.c events/SDL_events.c events/SDL_expose.c \
  events/SDL_keyboard.c events/SDL_mouse.c events/SDL_quit.c \
  events/SDL_resize.c \
  file/SDL_rwops.c \
  joystick/SDL_joystick.c \
  stdlib/SDL_getenv.c stdlib/SDL_iconv.c \
  stdlib/SDL_malloc.c stdlib/SDL_qsort.c \
  stdlib/SDL_stdlib.c stdlib/SDL_string.c \
  thread/SDL_thread.c \
  thread/pthread/SDL_syscond.c thread/pthread/SDL_sysmutex.c \
  thread/pthread/SDL_syssem.c thread/pthread/SDL_systhread.c \
  timer/SDL_timer.c timer/$(SDL_SYSTIMER) \
  video/SDL_blit_0.c video/SDL_blit_1.c video/SDL_blit_A.c \
  video/SDL_blit.c video/SDL_blit_N.c video/SDL_bmp.c video/SDL_cursor.c \
  video/SDL_gamma.c video/SDL_pixels.c video/SDL_RLEaccel.c \
  video/SDL_stretch.c video/SDL_surface.c video/SDL_video.c \
  video/SDL_yuv.c video/SDL_yuv_mmx.c video/SDL_yuv_sw.c \
  cdrom/dummy/SDL_syscdrom.c \
  joystick/dummy/SDL_sysjoystick.c \
  loadso/dummy/SDL_sysloadso.c \
)

# --- SDL → libretro bridge ---
SOURCES_C += $(addprefix $(SDL_LIBRETRO)/, \
  audio.c events.c video.c SDL_ttf.c \
)
SOURCES_CXX += $(SDL_LIBRETRO)/SDL_image.cpp

# --- SDL_mixer ---
SOURCES_C += $(addprefix $(DEPS_DIR)/sdl-mixer/, \
  mixer.c music.c effects_internal.c effect_position.c \
  load_voc.c load_aiff.c load_ogg.c music_ogg.c \
  dynamic_ogg.c music_mad.c \
)

# --- libretro-common ---
SOURCES_C += $(addprefix $(LIBRETRO_COMM)/, \
  compat/compat_strl.c \
  encodings/encoding_utf.c \
  string/stdstring.c \
  time/rtime.c \
  file/file_path.c \
)

# --- SMPEG (MPEG-1 audio/video decoder) ---
SOURCES_C   += $(SMPEG_DIR)/MPEGfilter.c
SOURCES_CXX += $(addprefix $(SMPEG_DIR)/, \
  MPEG.cpp MPEGlist.cpp MPEGring.cpp MPEGstream.cpp MPEGsystem.cpp smpeg.cpp \
)
SOURCES_CXX += $(addprefix $(SMPEG_DIR)/audio/, \
  MPEGaudio.cpp bitwindow.cpp filter.cpp filter_2.cpp hufftable.cpp \
  mpeglayer1.cpp mpeglayer2.cpp mpeglayer3.cpp mpegtable.cpp mpegtoraw.cpp \
)
SOURCES_CXX += $(addprefix $(SMPEG_DIR)/video/, \
  MPEGvideo.cpp decoders.cpp floatdct.cpp gdith.cpp jrevdct.cpp \
  motionvec.cpp parseblock.cpp readfile.cpp util.cpp vhar128.cpp video.cpp \
)

# =============================================================================
# Engine: ONScripter-EN
# Compiled as a static library with -fvisibility=hidden to avoid symbol
# conflicts with PONScripter (they share class names like ScriptHandler).
# =============================================================================
ONS_CXX := $(addprefix $(ONSCRIPTER_EN)/, \
  ONScripterLabel.cpp \
  ONScripterLabel_animation.cpp \
  ONScripterLabel_command.cpp \
  ONScripterLabel_effect.cpp \
  ONScripterLabel_effect_breakup.cpp \
  ONScripterLabel_effect_cascade.cpp \
  ONScripterLabel_effect_trig.cpp \
  ONScripterLabel_event.cpp \
  ONScripterLabel_file.cpp \
  ONScripterLabel_file2.cpp \
  ONScripterLabel_image.cpp \
  ONScripterLabel_rmenu.cpp \
  ONScripterLabel_sound.cpp \
  ONScripterLabel_text.cpp \
  resize_image.cpp \
  sjis2utf16.cpp \
  DirectReader.cpp \
  SarReader.cpp \
  NsaReader.cpp \
  ScriptHandler.cpp \
  ScriptParser.cpp \
  ScriptParser_command.cpp \
  FontInfo.cpp \
  AnimationInfo.cpp \
  DirtyRect.cpp \
  DirPaths.cpp \
  Layer.cpp \
  MadWrapper.cpp \
  graphics_routines.cpp \
)

ONS_OBJS := $(ONS_CXX:.cpp=.ons.o)
$(ONS_OBJS): CXXFLAGS += -fvisibility=hidden

# =============================================================================
# Engine: PONScripter
# Same approach — hidden visibility, separate object files.
# =============================================================================
PONS_CXX := $(addprefix $(PONSCRIPTER)/, \
  PonscripterLabel.cpp \
  PonscripterLabel_animation.cpp \
  PonscripterLabel_command.cpp \
  PonscripterLabel_effect.cpp \
  PonscripterLabel_event.cpp \
  PonscripterLabel_ext.cpp \
  PonscripterLabel_file.cpp \
  PonscripterLabel_file2.cpp \
  PonscripterLabel_image.cpp \
  PonscripterLabel_rmenu.cpp \
  PonscripterLabel_sound.cpp \
  PonscripterLabel_text.cpp \
  ScriptHandler.cpp \
  ScriptParser.cpp \
  ScriptParser_command.cpp \
  AnimationInfo.cpp \
  DirtyRect.cpp \
  DirPaths.cpp \
  DirectReader.cpp \
  SarReader.cpp \
  NsaReader.cpp \
  MadWrapper.cpp \
  resize_image.cpp \
  font.cpp \
  Fontinfo.cpp \
  encoding.cpp \
  cp932_encoding.cpp \
  expression.cpp \
  prng.cpp \
  pstring.cpp \
  bstrwrap.cpp \
)

PONS_OBJS := $(PONS_CXX:.cpp=.pons.o)
PONS_C := $(PONSCRIPTER)/bstrlib.c
PONS_OBJS += $(PONS_C:.c=.pons.o)

# =============================================================================
# Core files (libretro API + C ABI wrappers for both engines)
# =============================================================================
SOURCES_CXX += \
  $(CORE_DIR)/libretro.cpp \
  $(CORE_DIR)/embed_stub.cpp
